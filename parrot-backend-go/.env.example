# 服务配置
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
UPLOAD_DIR=./uploads
REQUEST_LOG_SLOW_MS=500
CACHE_TTL_SECONDS=300
QUEUE_CONCURRENCY=10

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=parrot
PG_PASSWORD=Parrot123
PG_DATABASE=parrot
PG_SSLMODE=disable

# AI Provider（OpenAI 兼容）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MODELS=gpt-4o-mini,gpt-4.1-mini

# 阶段 2 微服务
# etcd 服务发现地址（配置后网关和 dubbing-service 通过 etcd 自动发现）
# 留空则使用直连模式（DUBBING_SERVICE_ADDR），适合本地开发
ETCD_ADDR=
# dubbing-service 直连地址（ETCD_ADDR 为空时使用）
DUBBING_SERVICE_ADDR=127.0.0.1:8888
# dubbing-service 监听端口
DUBBING_SERVICE_PORT=8888

# 阶段 3 链路追踪（OTLP HTTP 端口，默认 Jaeger 4318）
JAEGER_ENDPOINT=localhost:4318
